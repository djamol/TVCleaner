<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0E14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press a remote button"
            android:textColor="#FFF5F7FA"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/captureHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Listening… Back cancels"
            android:textColor="#FF9AA3B2"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/captureDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="#FF3DDC97"
            android:textSize="22sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</FrameLayout>
